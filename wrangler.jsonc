{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medpally-find",
  "compatibility_date": "2026-10-27",
  "main": "./worker/index.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "routes": [{ "pattern": "find.medpally.com", "custom_domain": true }],
  "vars": { "GITHUB_REPO": "realikechukwu/medpally-find" },
  // Secrets (set in Cloudflare, not here): GITHUB_TOKEN, TURNSTILE_SECRET_KEY
  "ratelimits": [{ "name": "SUGGEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
}
