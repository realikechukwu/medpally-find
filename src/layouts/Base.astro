---
import { Font } from 'astro:assets';
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';
import { pluralLabel, usedTypes } from '../lib/items';
interface Props { title?: string; description?: string; image?: string | null; noindex?: boolean; photoHeader?: boolean; }
const { title = 'Cardiology and cardiac critical care resources | MedPally Find', description = 'A free directory of cardiology and cardiac critical care tools, apps and learning resources, created by Marlo Solutions Ltd.', image, noindex = false, photoHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/404' || Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
const ogImage = image ?? new URL('/og.png', Astro.site).href;
// TODO(curator): confirm official social profiles before adding sameAs URLs.
const organization = { '@type': 'Organization', '@id': new URL('/#organization', Astro.site).href, name: 'Marlo Solutions Ltd', url: new URL('/', Astro.site).href, logo: new URL('/icon-512.png', Astro.site).href };
const website = { '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, name: 'MedPally Find', url: new URL('/', Astro.site).href, publisher: { '@id': organization['@id'] }, potentialAction: { '@type': 'SearchAction', target: `${new URL('/browse/', Astro.site).href}?q={search_term_string}`, 'query-input': 'required name=search_term_string' } };
const current = (path: string) => Astro.url.pathname === path ? 'page' : undefined;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex"/>}<Font cssVariable="--font-inter" preload/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/><meta name="theme-color" content="#121315" media="(prefers-color-scheme: dark)"/><meta property="og:type" content="website"/><meta property="og:site_name" content="MedPally Find"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><link rel="alternate" type="application/rss+xml" title="MedPally Find blog" href="/blog/rss.xml"/><title>{title}</title><JsonLd data={{ '@context': 'https://schema.org', '@graph': [website, organization] }}/></head><body><a class="skip-link" href="#main">Skip to content</a><header class:list={['site-header', { 'on-photo': photoHeader }]}><div class="shell header-inner"><a class="wordmark" href="/" aria-label="MedPally Find home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M13 45V20L25.5 36L38 20V45" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><circle class="brand-dot" cx="49" cy="42" r="4.6"/></svg></span><span><strong>MedPally</strong> Find<span class="wordmark-dot">.</span></span></a><nav class="header-nav" aria-label="Your resources"><a href="/" aria-current={current('/')}>Home</a><a href="/browse/" aria-current={current('/browse/')}>Browse</a><a href="/blog/" aria-current={current('/blog/')}>Blog</a><a href="/about/" aria-current={current('/about/')}>About</a><a href="/suggest/" aria-current={current('/suggest/')}>Suggest</a><a href="/saved/" aria-current={current('/saved/')}>Saved<span class="saved-count" data-saved-count hidden></span></a></nav><button class="menu-button" type="button" aria-label="Menu" aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false" data-menu-open><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></div></header><dialog id="site-menu" class="site-menu" aria-label="Menu"><div class="menu-head"><a class="wordmark" href="/" aria-label="MedPally Find home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M13 45V20L25.5 36L38 20V45" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><circle class="brand-dot" cx="49" cy="42" r="4.6"/></svg></span><span><strong>MedPally</strong> Find<span class="wordmark-dot">.</span></span></a><button class="menu-dismiss" type="button" aria-label="Close menu" autofocus data-menu-close><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></div><div class="menu-body"><form class="menu-search" action="/browse/" autocomplete="off"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><label class="sr-only" for="menu-search">Search resources</label><input id="menu-search" name="q" type="search" enterkeyhint="search" placeholder="Search tools, topics, creators"/></form><nav class="menu-links" aria-label="Site"><a href="/" aria-current={current('/')}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1v-8.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Home</span></a><a href="/browse/" aria-current={current('/browse/')}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 4.5h6v6h-6zM13.5 4.5h6v6h-6zM4.5 13.5h6v6h-6zM13.5 13.5h6v6h-6z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Browse</span></a><a href="/topics/" aria-current={current('/topics/')}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12.6V5a1 1 0 0 1 1-1h7.6a1 1 0 0 1 .7.3l6.4 6.4a1 1 0 0 1 0 1.4l-7.6 7.6a1 1 0 0 1-1.4 0l-6.4-6.4a1 1 0 0 1-.3-.7ZM8.5 8.5h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Topics</span></a><a href="/saved/" aria-current={current('/saved/')}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 4.5h10a1 1 0 0 1 1 1v14l-6-4-6 4v-14a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Saved</span><span class="saved-count" data-saved-count hidden></span></a><a href="/blog/" aria-current={current('/blog/')}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-10.5a.5.5 0 0 1-.5-.5V4a.5.5 0 0 1 .5-.5ZM9.5 12h5M9.5 16h5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Blog</span></a><a href="/about/" aria-current={current('/about/')}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17ZM12 11v5.5M12 7.5h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span>About</span></a></nav></div><div class="menu-foot"><a class="primary-button menu-suggest" href="/suggest/" aria-current={current('/suggest/')}>Suggest a resource</a><p>Free to use · no sign-up</p></div></dialog><slot/><footer class="site-footer"><div class="shell"><div class="footer-grid"><div class="footer-about"><p class="footer-brand"><strong>MedPally</strong> Find</p><p>A free directory of tools, apps and learning resources for cardiology and cardiac critical care.</p><p class="footer-disclaimer">Listings link to third-party resources. They are not clinical advice or endorsements; always check against local guidance.</p></div><nav aria-label="Browse"><h2>Browse</h2><ul><li><a href="/browse/">All resources</a></li><li><a href="/topics/">Topics</a></li><li><a href="/blog/">Blog</a></li><li><a href="/about/">About</a></li><li><a href="/saved/">Saved</a></li>{usedTypes.map(type => <li><a href={`/types/${type}/`}>{pluralLabel(type)}</a></li>)}</ul></nav><nav aria-label="Get in touch"><h2>Get in touch</h2><ul><li><a href="/suggest/">Suggest a resource</a></li><li><a href="mailto:hello@marlosolutions.com?subject=MedPally%20Find%3A%20listing%20correction">Correct or remove a listing</a></li><li><a href="mailto:hello@marlosolutions.com?subject=MedPally%20Find">hello@marlosolutions.com</a></li></ul></nav><nav aria-label="Legal"><h2>Legal</h2><ul><li><a href="/privacy/">Privacy notice</a></li><li><a href="/terms/">Terms of use</a></li><li><a href="https://marlosolutions.com" target="_blank" rel="noopener">Marlo Solutions</a></li><li><a href="https://www.clinote.co" target="_blank" rel="noopener">Clinote</a></li></ul></nav></div><div class="footer-bottom"><p>MedPally Find is created by <a href="https://marlosolutions.com" target="_blank" rel="noopener">Marlo Solutions Ltd</a>, registered in England and Wales, company no. 17309992. Registered office: Suite RA01, 195–197 Wood Street, London E17 3NU, United Kingdom.</p><div class="footer-meta"><p>© {new Date().getFullYear()} Marlo Solutions Ltd</p><slot name="footer"/></div></div></div></footer><script>
const days = (iso: string) => Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 86400000));
const ago = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'} ago`;
for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
 const d = days(el.dateTime);
 el.title = el.textContent ?? '';
 el.textContent = d === 0 ? 'today' : d === 1 ? 'yesterday' : d < 7 ? ago(d, 'day') : d < 30 ? ago(Math.floor(d / 7), 'week') : d < 365 ? ago(Math.floor(d / 30), 'month') : el.textContent;
}
// Menu drawer: a modal dialog, so the page behind is inert and Escape closes it. Tapping the dimmed page also closes it.
// Closing slides the drawer out first and only then closes the dialog: Safari and Firefox can't animate a dialog leaving the top layer, so a plain close() snaps it away.
const menu = document.querySelector<HTMLDialogElement>('#site-menu')!;
const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
const closeMenu = () => {
 if (!menu.open || menu.hasAttribute('data-closing')) return;
 if (reduceMotion.matches) return menu.close();
 const finish = (event?: TransitionEvent) => {
  if (event && (event.target !== menu || event.propertyName !== 'transform')) return;
  clearTimeout(fallback); menu.removeEventListener('transitionend', finish);
  if (menu.hasAttribute('data-closing')) { menu.close(); menu.removeAttribute('data-closing'); }
 };
 const fallback = setTimeout(finish, 400);
 menu.addEventListener('transitionend', finish);
 menu.setAttribute('data-closing', '');
};
opener.addEventListener('click', () => { menu.showModal(); opener.setAttribute('aria-expanded', 'true'); });
menu.addEventListener('close', () => { opener.setAttribute('aria-expanded', 'false'); menu.removeAttribute('data-closing'); });
menu.addEventListener('cancel', event => { event.preventDefault(); closeMenu(); });
menu.querySelector('[data-menu-close]')!.addEventListener('click', closeMenu);
menu.addEventListener('click', event => { const box = menu.getBoundingClientRect(); if (event.target === menu && (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom)) closeMenu(); });
matchMedia('(min-width: 601px)').addEventListener('change', event => { if (event.matches) menu.close(); });
</script><script src="../scripts/saved.ts"></script></body></html>
