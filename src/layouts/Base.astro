---
import { Font } from 'astro:assets';
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';
import { pluralLabel, usedTypes } from '../lib/items';
interface Props { title?: string; description?: string; image?: string | null; noindex?: boolean; photoHeader?: boolean; }
const { title = 'Cardiology and cardiac critical care resources | MedPally Find', description = 'A free directory of cardiology and cardiac critical care tools, apps and learning resources, created by Marlo Solutions Ltd.', image, noindex = false, photoHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/404' || Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname, Astro.site);
const ogImage = image ?? new URL('/og.png', Astro.site).href;
// TODO(curator): confirm official social profiles before adding sameAs URLs.
const organization = { '@type': 'Organization', '@id': new URL('/#organization', Astro.site).href, name: 'Marlo Solutions Ltd', url: new URL('/', Astro.site).href, logo: new URL('/icon-512.png', Astro.site).href };
const website = { '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, name: 'MedPally Find', url: new URL('/', Astro.site).href, publisher: { '@id': organization['@id'] }, potentialAction: { '@type': 'SearchAction', target: `${new URL('/browse/', Astro.site).href}?q={search_term_string}`, 'query-input': 'required name=search_term_string' } };
const current = (path: string) => Astro.url.pathname === path ? 'page' : undefined;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex"/>}<Font cssVariable="--font-inter" preload/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/><meta name="theme-color" content="#121315" media="(prefers-color-scheme: dark)"/><meta property="og:type" content="website"/><meta property="og:site_name" content="MedPally Find"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><link rel="alternate" type="application/rss+xml" title="MedPally Find blog" href="/blog/rss.xml"/><title>{title}</title><JsonLd data={{ '@context': 'https://schema.org', '@graph': [website, organization] }}/></head><body><a class="skip-link" href="#main">Skip to content</a><header class:list={['site-header', { 'on-photo': photoHeader }]}><div class="shell header-inner"><a class="wordmark" href="/" aria-label="MedPally Find home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M13 45V20L25.5 36L38 20V45" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><circle class="brand-dot" cx="49" cy="42" r="4.6"/></svg></span><span><strong>MedPally</strong> Find<span class="wordmark-dot">.</span></span></a><nav class="header-nav" aria-label="Your resources"><a href="/" aria-current={current('/')}>Home</a><a href="/browse/" aria-current={current('/browse/')}>Browse</a><a href="/blog/" aria-current={current('/blog/')}>Blog</a><a href="/about/" aria-current={current('/about/')}>About</a><a href="/suggest/" aria-current={current('/suggest/')}>Suggest</a><a href="/saved/" aria-current={current('/saved/')}>Saved<span class="saved-count" data-saved-count hidden></span></a></nav><button class="menu-button" type="button" popovertarget="site-menu" aria-label="Menu"><svg class="menu-open" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><svg class="menu-close" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button><nav id="site-menu" class="site-menu" popover aria-label="Menu"><a href="/" aria-current={current('/')}>Home</a><a href="/browse/" aria-current={current('/browse/')}>Browse</a><a href="/saved/" aria-current={current('/saved/')}>Saved<span class="saved-count" data-saved-count hidden></span></a><a href="/blog/" aria-current={current('/blog/')}>Blog</a><a href="/about/" aria-current={current('/about/')}>About</a><a href="/suggest/" aria-current={current('/suggest/')}>Suggest a resource</a></nav></div></header><slot/><footer class="site-footer"><div class="shell"><div class="footer-grid"><div class="footer-about"><p class="footer-brand"><strong>MedPally</strong> Find</p><p>A free directory of tools, apps and learning resources for cardiology and cardiac critical care.</p><p class="footer-disclaimer">Listings link to third-party resources. They are not clinical advice or endorsements; always check against local guidance.</p></div><nav aria-label="Browse"><h2>Browse</h2><ul><li><a href="/browse/">All resources</a></li><li><a href="/topics/">Topics</a></li><li><a href="/blog/">Blog</a></li><li><a href="/about/">About</a></li><li><a href="/saved/">Saved</a></li>{usedTypes.map(type => <li><a href={`/types/${type}/`}>{pluralLabel(type)}</a></li>)}</ul></nav><nav aria-label="Get in touch"><h2>Get in touch</h2><ul><li><a href="/suggest/">Suggest a resource</a></li><li><a href="mailto:hello@marlosolutions.com?subject=MedPally%20Find%3A%20listing%20correction">Correct or remove a listing</a></li><li><a href="mailto:hello@marlosolutions.com?subject=MedPally%20Find">hello@marlosolutions.com</a></li></ul></nav><nav aria-label="Legal"><h2>Legal</h2><ul><li><a href="/privacy/">Privacy notice</a></li><li><a href="/terms/">Terms of use</a></li><li><a href="https://marlosolutions.com" target="_blank" rel="noopener">Marlo Solutions</a></li><li><a href="https://www.clinote.co" target="_blank" rel="noopener">Clinote</a></li></ul></nav></div><div class="footer-bottom"><p>MedPally Find is created by <a href="https://marlosolutions.com" target="_blank" rel="noopener">Marlo Solutions Ltd</a>, registered in England and Wales, company no. 17309992. Registered office: Suite RA01, 195–197 Wood Street, London E17 3NU, United Kingdom.</p><div class="footer-meta"><p>© {new Date().getFullYear()} Marlo Solutions Ltd</p><slot name="footer"/></div></div></div></footer><script>
const days = (iso: string) => Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 86400000));
const ago = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'} ago`;
for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
 const d = days(el.dateTime);
 el.title = el.textContent ?? '';
 el.textContent = d === 0 ? 'today' : d === 1 ? 'yesterday' : d < 7 ? ago(d, 'day') : d < 30 ? ago(Math.floor(d / 7), 'week') : d < 365 ? ago(Math.floor(d / 30), 'month') : el.textContent;
}
</script><script src="../scripts/saved.ts"></script></body></html>
