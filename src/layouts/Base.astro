---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { activeItems, pluralLabel } from '../lib/items';
import { types } from '../lib/schema';
const usedTypes = types.filter(type => activeItems.some(item => item.type === type));
interface Props { title?: string; description?: string; image?: string | null; }
const { title = 'Cardiology and cardiac critical care resources | MedPally Find', description = 'A free directory of cardiology and cardiac critical care tools, apps and learning resources, created by Marlo Solutions Ltd.', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? new URL('/og.png', Astro.site).href;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><Font cssVariable="--font-inter" preload/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#fcfbf8" media="(prefers-color-scheme: light)"/><meta name="theme-color" content="#181817" media="(prefers-color-scheme: dark)"/><meta property="og:type" content="website"/><meta property="og:site_name" content="MedPally Find"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><title>{title}</title></head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="shell header-inner"><a class="wordmark" href="/" aria-label="MedPally Find home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M13 45V20L25.5 36L38 20V45" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><circle class="brand-dot" cx="49" cy="42" r="4.6"/></svg></span><span><strong>MedPally</strong> Find<span class="wordmark-dot">.</span></span></a><span class="header-note">Cardiology and ITU resources</span></div></header><slot/><footer class="site-footer"><div class="shell"><div class="footer-grid"><div class="footer-about"><p class="footer-brand"><strong>MedPally</strong> Find</p><p>A free directory of tools, apps and learning resources for cardiology and cardiac critical care.</p><p class="footer-disclaimer">Listings link to third-party resources. They are not clinical advice or endorsements; always check against local guidance.</p></div><nav aria-label="Browse"><h2>Browse</h2><ul><li><a href="/">All resources</a></li>{usedTypes.map(type => <li><a href={`/?type=${type}`}>{pluralLabel(type)}</a></li>)}</ul></nav><nav aria-label="Get in touch"><h2>Get in touch</h2><ul><li><a href="mailto:hello@marlosolutions.com?subject=MedPally%20Find%3A%20suggest%20a%20resource">Suggest a resource</a></li><li><a href="mailto:hello@marlosolutions.com?subject=MedPally%20Find%3A%20listing%20correction">Correct or remove a listing</a></li><li><a href="mailto:hello@marlosolutions.com?subject=MedPally%20Find">hello@marlosolutions.com</a></li></ul></nav><nav aria-label="Legal"><h2>Legal</h2><ul><li><a href="/privacy/">Privacy notice</a></li><li><a href="/terms/">Terms of use</a></li><li><a href="https://marlosolutions.com" target="_blank" rel="noopener">Marlo Solutions</a></li><li><a href="https://www.clinote.co" target="_blank" rel="noopener">Clinote</a></li></ul></nav></div><div class="footer-bottom"><p>MedPally Find is created by <a href="https://marlosolutions.com" target="_blank" rel="noopener">Marlo Solutions Ltd</a>, registered in England and Wales, company no. 17309992. Registered office: Suite RA01, 195–197 Wood Street, London E17 3NU, United Kingdom.</p><div class="footer-meta"><p>© {new Date().getFullYear()} Marlo Solutions Ltd</p><slot name="footer"/></div></div></div></footer><script>
const days = (iso: string) => Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 86400000));
const ago = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'} ago`;
for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
 const d = days(el.dateTime);
 el.title = el.textContent ?? '';
 el.textContent = d === 0 ? 'today' : d === 1 ? 'yesterday' : d < 7 ? ago(d, 'day') : d < 30 ? ago(Math.floor(d / 7), 'week') : d < 365 ? ago(Math.floor(d / 30), 'month') : el.textContent;
}
</script></body></html>
