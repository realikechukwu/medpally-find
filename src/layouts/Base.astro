---
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string | null; }
const { title = 'Cardiology and cardiac critical care resources | MedPally Find', description = 'A free directory of cardiology and cardiac critical care tools, apps and learning resources, curated by MedPally.', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? new URL('/og.png', Astro.site).href;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><meta name="theme-color" content="#fcfbf8" media="(prefers-color-scheme: light)"/><meta name="theme-color" content="#181817" media="(prefers-color-scheme: dark)"/><meta property="og:type" content="website"/><meta property="og:site_name" content="MedPally Find"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><title>{title}</title></head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="shell header-inner"><a class="wordmark" href="/" aria-label="MedPally Find home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M13 45V20L25.5 36L38 20V45" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/><circle class="brand-dot" cx="49" cy="42" r="4.6"/></svg></span><span><strong>MedPally</strong> Find<span class="wordmark-dot">.</span></span></a><span class="header-note">Cardiology and ITU resources</span></div></header><slot/><footer class="site-footer"><div class="shell footer-inner"><p>Curated by MedPally.</p><slot name="footer"/></div></footer><script>
const days = (iso: string) => Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 86400000));
const ago = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'} ago`;
for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
 const d = days(el.dateTime);
 el.title = el.textContent ?? '';
 el.textContent = d === 0 ? 'today' : d === 1 ? 'yesterday' : d < 7 ? ago(d, 'day') : d < 30 ? ago(Math.floor(d / 7), 'week') : d < 365 ? ago(Math.floor(d / 30), 'month') : el.textContent;
}
</script></body></html>
