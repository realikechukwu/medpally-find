---
import Base from '../layouts/Base.astro';
// Site keys are public. Without one, Cloudflare's always-pass test key is used, which the production secret rejects.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---
<Base title="Suggest a resource | MedPally Find" description="Suggest a cardiology or cardiac critical care tool, app or learning resource for MedPally Find."><main id="main" class="shell suggest-page"><a class="back-link" href="/"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14.5 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>All resources</a><div class="section-kicker">SUGGEST</div><h1>Know a good resource?</h1><p class="suggest-lead">Send us a tool, app, course or guideline for cardiology or cardiac critical care. We read every suggestion before anything is added.</p>
<form class="suggest-form" id="suggest-form" action="/api/suggest" method="post" novalidate><div class="field"><label for="suggest-url">Link</label><input id="suggest-url" name="url" type="url" inputmode="url" placeholder="https://" required maxlength="2000" autocomplete="url"/></div><div class="field"><label for="suggest-note">Why is it useful? <span>Optional</span></label><textarea id="suggest-note" name="note" rows="4" maxlength="1000"></textarea></div><div class="honeypot" aria-hidden="true"><label for="suggest-website">Leave this empty</label><input id="suggest-website" name="website" tabindex="-1" autocomplete="off"/></div><p class="suggest-public">Suggestions are posted publicly on <a href="https://github.com/realikechukwu/medpally-find/issues?q=label%3Asuggestion" target="_blank" rel="noopener">GitHub</a> for review. Don't include your name, contact details or anything about patients.</p><div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible" data-action="suggest"></div><button class="primary-button" type="submit">Send suggestion</button><p class="form-status" id="suggest-status" role="status" aria-live="polite"></p></form></main>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
declare const turnstile: { reset(): void } | undefined;
const form = document.querySelector<HTMLFormElement>('#suggest-form')!;
const url = form.querySelector<HTMLInputElement>('[name=url]')!;
const status = document.querySelector<HTMLElement>('#suggest-status')!;
const submit = form.querySelector<HTMLButtonElement>('[type=submit]')!;
const prefill = new URLSearchParams(location.search).get('url');
if (prefill) url.value = prefill;
function show(message: string, kind: 'error' | 'ok', link?: { href: string; text: string }) {
 status.className = `form-status ${kind}`;
 status.replaceChildren(message);
 if (link) { const a = document.createElement('a'); a.href = link.href; a.textContent = link.text; status.append(' ', a); }
}
form.addEventListener('submit', async event => {
 event.preventDefault();
 if (!url.checkValidity()) { show('Enter a full link, starting with https://', 'error'); url.focus(); return; }
 submit.disabled = true; show('Sending…', 'ok');
 try {
  const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
  const result = await response.json().catch(() => ({})) as { message?: string; item?: { href: string; title: string } };
  if (!response.ok) { show(result.message ?? 'Something went wrong. Please try again.', 'error'); return; }
  show(result.message ?? 'Thanks, we have it.', 'ok', result.item ? { href: result.item.href, text: result.item.title } : undefined);
  if (!result.item) form.reset();
 } catch { show('Could not reach the server. Check your connection and try again.', 'error'); }
 finally { submit.disabled = false; if (typeof turnstile !== 'undefined') turnstile.reset(); }
});
</script></Base>
