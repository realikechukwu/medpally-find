---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { activeItems, label, pluralLabel } from '../lib/items';
import tags from '../../data/tags.json';
import { types } from '../lib/schema';
const usedTypes = types.filter(type => activeItems.some(item => item.type === type));
const usedTags = tags.filter(tag => activeItems.some(item => item.tags.includes(tag)));
---
<Base title="Browse resources | MedPally Find" description="Search and filter cardiology and cardiac critical care tools, apps, courses and guidelines."><main id="main"><section class="shell browse-intro"><div class="section-kicker">BROWSE</div><h1>All resources</h1><form class="search-box browse-search" role="search" action="/browse/" autocomplete="off"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><label class="sr-only" for="search">Search resources</label><input id="search" name="q" placeholder="Search tools, topics, creators"/><kbd>/</kbd><button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></form></section>
<section class="browse shell" aria-label="Filter resources"><div class="category-bar" role="group" aria-label="Filter by resource type"><button class="category active" data-category="" data-label="All" aria-pressed="true">All</button>{usedTypes.map(type => <button class="category" data-category={type} data-label={pluralLabel(type)} aria-pressed="false">{pluralLabel(type)}</button>)}</div><div class="tags-row"><span class="tags-heading">TOPICS</span><div class="tag-scroll" role="group" aria-label="Filter by topic">{usedTags.map(tag => <button class="tag-chip" data-tag={tag} aria-pressed="false">{label(tag)}</button>)}</div></div></section>
<section class="shell all-section" aria-label="Results"><p id="result-count" class="sr-only" aria-live="polite">{activeItems.length} resources</p><div class="cards-grid" id="cards">{activeItems.map(item => <Card item={item}/>)}</div><nav class="pagination" id="pagination" aria-label="Pages" hidden></nav><div class="empty-state" id="empty" hidden><h3>No matching resources.</h3><p>Try a different search or clear your filters.</p><button id="clear-filters">Clear filters</button><a class="suggest-link" href="/suggest/">Know one we're missing? Suggest it</a></div></section></main><script src="../scripts/search.ts"></script></Base>
