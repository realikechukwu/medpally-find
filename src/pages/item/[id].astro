---
import Base from '../../layouts/Base.astro';
import { activeItems, date, label } from '../../lib/items';
export function getStaticPaths() { return activeItems.map(item => ({ params: { id: item.id }, props: { item } })); }
const { item } = Astro.props;
---
<Base title={`${item.title} | MedPally Find`} description={item.summary} image={item.image}><main id="main" class="shell detail"><a class="back-link" href="/"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14.5 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>All resources</a><div class="detail-layout"><div><div class="section-kicker">{label(item.type).toUpperCase()}</div><h1>{item.title}</h1><p class="detail-summary">{item.summary}</p><div class="detail-actions"><a class="primary-button" href={item.url} target="_blank" rel="noopener noreferrer">Open resource <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 16 16 8M9 8h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a><button class="secondary-button save-button" type="button" data-save={item.id} data-save-label aria-pressed="false" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5h10a1 1 0 0 1 1 1v14l-6-4-6 4v-14a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span>Save</span></button></div>{item.note && <aside class="personal-note"><div class="section-kicker">A NOTE FROM MEDPALLY</div><p>{item.note}</p></aside>}</div><aside class="detail-meta"><h2>Details</h2><dl><div><dt>Type</dt><dd>{label(item.type)}</dd></div><div><dt>Topics</dt><dd>{item.tags.map(label).join(', ')}</dd></div><div><dt>Maker</dt><dd>{item.maker ? (item.maker_url ? <a href={item.maker_url} target="_blank" rel="noopener noreferrer">{item.maker}</a> : item.maker) : 'Unknown'}</dd></div><div><dt>Pricing</dt><dd>{item.pricing}</dd></div><div><dt>Platform</dt><dd>{item.platforms.length ? item.platforms.map(label).join(', ') : 'Unknown'}</dd></div><div><dt>Added</dt><dd>{date(item.added_at)}</dd></div><div><dt>Updated</dt><dd>{date(item.updated_at)}</dd></div>{item.source_url && <div><dt>Found via</dt><dd><a href={item.source_url} target="_blank" rel="noopener noreferrer">Original source</a></dd></div>}</dl></aside></div></main><Fragment slot="footer"><p>{activeItems.length} resources in the collection</p></Fragment></Base>
