---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import JsonLd from '../../components/JsonLd.astro';
import { activeItems, date, label, slug } from '../../lib/items';
export function getStaticPaths() { return activeItems.map(item => ({ params: { id: item.id }, props: { item } })); }
const { item } = Astro.props;
const topic = item.tags[0];
const related = activeItems.filter(other => other.id !== item.id).map(other => ({ item: other, shared: other.tags.filter(tag => item.tags.includes(tag)).length, sameType: other.type === item.type })).filter(other => other.shared || other.sameType).sort((a, b) => b.shared - a.shared || Number(b.sameType) - Number(a.sameType)).slice(0, 4);
const site = 'https://find.medpally.com';
const topicUrl = topic ? `${site}/topics/${slug(topic)}/` : `${site}/topics/`;
const breadcrumb = [{ name: 'Home', item: `${site}/` }, ...(topic ? [{ name: label(topic), item: topicUrl }] : []), { name: item.title, item: `${site}/item/${item.id}/` }];
const resource = { '@type': 'CreativeWork', name: item.title, url: item.url, description: item.summary, ...(item.maker ? { author: { name: item.maker, ...(item.maker_url ? { url: item.maker_url } : {}) } } : {}), ...(item.pricing === 'free' ? { isAccessibleForFree: true } : {}) };
const topicName = topic ? label(topic).replace(/^./, c => c.toUpperCase()) : '';
const longTitle = `${item.title}: ${topicName ? `${topicName} ${label(item.type)}` : label(item.type)} | MedPally Find`;
const title = longTitle.length <= 65 ? longTitle : `${item.title} | MedPally Find`;
---
<Base title={title} description={item.summary} image={item.image}><JsonLd data={{ '@context': 'https://schema.org', '@graph': [{ '@type': 'BreadcrumbList', itemListElement: breadcrumb.map((entry, index) => ({ '@type': 'ListItem', position: index + 1, ...entry })) }, { '@type': 'WebPage', name: item.title, url: `${site}/item/${item.id}/`, description: item.summary, mainEntity: resource }] }}/><main id="main" class="shell detail"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{topic && <><span aria-hidden="true">›</span><a href={`/topics/${slug(topic)}/`}>{label(topic)}</a></>}<span aria-hidden="true">›</span><span aria-current="page">{item.title}</span></nav><a class="back-link" href="/browse/"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14.5 6-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>All resources</a><div class="detail-layout"><div><div class="section-kicker">{label(item.type).toUpperCase()}</div><h1>{item.title}</h1><p class="detail-summary">{item.summary}</p><div class="detail-actions"><a class="primary-button" href={item.url} target="_blank" rel="noopener noreferrer">Open resource <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 16 16 8M9 8h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a><button class="secondary-button save-button" type="button" data-save={item.id} data-save-label aria-pressed="false" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5h10a1 1 0 0 1 1 1v14l-6-4-6 4v-14a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span>Save</span></button></div>{item.note && <aside class="personal-note"><div class="section-kicker">A NOTE FROM MEDPALLY</div><p>{item.note}</p></aside>}</div><aside class="detail-meta"><h2>Details</h2><dl><div><dt>Type</dt><dd>{label(item.type)}{item.clinician_built && <> · <a href="/types/clinician-built/">Clinician-built</a></>}</dd></div><div><dt>Topics</dt><dd>{item.tags.map((tag, index) => <>{index > 0 && ', '}<a href={`/topics/${slug(tag)}/`}>{label(tag)}</a></>)}</dd></div><div><dt>Made by</dt><dd>{item.maker ? (item.maker_url ? <a href={item.maker_url} target="_blank" rel="noopener noreferrer">{item.maker}</a> : item.maker) : 'Unknown'}</dd></div><div><dt>Pricing</dt><dd>{item.pricing}</dd></div><div><dt>Platform</dt><dd>{item.platforms.length ? item.platforms.map(label).join(', ') : 'Unknown'}</dd></div><div><dt>Added</dt><dd>{date(item.added_at)}</dd></div><div><dt>Updated</dt><dd>{date(item.updated_at)}</dd></div>{item.source_url && <div><dt>Found via</dt><dd><a href={item.source_url} target="_blank" rel="noopener noreferrer">Original source</a></dd></div>}</dl></aside></div>{related.length > 0 && <section class="related-resources"><div class="section-heading"><h2>Related resources</h2></div><div class="cards-grid">{related.map(({ item: relatedItem }) => <Card item={relatedItem}/>)}</div></section>}</main><Fragment slot="footer"><p>{activeItems.length} resources in the collection</p></Fragment></Base>
