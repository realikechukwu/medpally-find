---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { activeItems, date, label } from '../lib/items';
import tags from '../../data/tags.json';
const latest = activeItems.slice(0, 4);
const updated = activeItems.map(i => i.updated_at).sort().at(-1);
const usedTags = tags.filter(tag => activeItems.some(item => item.tags.includes(tag)));
---
<Base><script is:inline>if(/[?&](q|type|tag)=/.test(location.search))location.replace("/browse/"+location.search)</script><main id="main"><section class="hero shell"><div class="hero-eyebrow">CARDIOLOGY &amp; CARDIAC ITU</div><h1>Tools and learning<br/><em>for cardiac care.</em></h1><p>Apps, calculators, courses and guidelines for<br class="desktop-break"/> cardiology and cardiac critical care.</p><form class="search-box" role="search" action="/browse/" autocomplete="off"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><label class="sr-only" for="search">Search resources</label><input id="search" name="q" placeholder="Search tools, topics, creators"/><kbd>/</kbd><button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></form><div class="hero-footnote">FREE TO USE · NO SIGN-UP</div></section>
<section class="browse home-topics shell" aria-label="Browse by topic"><div class="tags-row"><span class="tags-heading">TOPICS</span><nav class="tag-scroll" aria-label="Browse by topic">{usedTags.map(tag => <a class="tag-chip" href={`/browse/?tag=${encodeURIComponent(tag)}`}>{label(tag)}</a>)}</nav></div></section>
<section class="shell new-section home-latest"><div class="section-heading"><div><div class="section-kicker">LATEST</div><h2>Recently added</h2></div><a class="see-all" href="/browse/">All {activeItems.length} resources <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div><div class="new-strip">{latest.map(item => <Card item={item} compact />)}</div><a class="secondary-button browse-all" href="/browse/">Browse all {activeItems.length} resources</a></section></main><Fragment slot="footer"><p>{updated ? `Last updated ${date(updated)} · ` : ''}{activeItems.length} resources</p></Fragment><script src="../scripts/home.ts"></script></Base>
