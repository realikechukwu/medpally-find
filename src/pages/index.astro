---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { activeItems, date, label, pluralLabel } from '../lib/items';
import tags from '../../data/tags.json';
import { types } from '../lib/schema';
const latest = activeItems.length > 8 ? activeItems.slice(0, 4) : [];
const updated = activeItems.map(i => i.updated_at).sort().at(-1);
const usedTypes = types.filter(type => activeItems.some(item => item.type === type));
const usedTags = tags.filter(tag => activeItems.some(item => item.tags.includes(tag)));
---
<Base><main id="main"><section class="hero shell"><div class="hero-eyebrow">CARDIOLOGY &amp; CARDIAC ITU</div><h1>Tools and learning<br/><em>for cardiac care.</em></h1><p>Apps, calculators, courses and guidelines for<br class="desktop-break"/> cardiology and cardiac critical care.</p><form class="search-box" role="search" action="/" autocomplete="off"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><label class="sr-only" for="search">Search resources</label><input id="search" name="q" placeholder="Search tools, topics, makers"/><kbd>/</kbd><button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></form><div class="hero-footnote">FREE TO USE · NO SIGN-UP</div></section>
<section class="browse shell" aria-label="Browse resources"><div class="category-bar" role="group" aria-label="Filter by resource type"><button class="category active" data-category="" data-label="All" aria-pressed="true">All</button>{usedTypes.map(type => <button class="category" data-category={type} data-label={pluralLabel(type)} aria-pressed="false">{pluralLabel(type)}</button>)}</div><div class="tags-row"><span class="tags-heading">TOPICS</span><div class="tag-scroll" role="group" aria-label="Filter by topic">{usedTags.map(tag => <button class="tag-chip" data-tag={tag} aria-pressed="false">{label(tag)}</button>)}</div></div></section>
{latest.length > 0 && <section class="shell new-section" id="new-section"><div class="section-heading"><div><div class="section-kicker">LATEST</div><h2>Recently added</h2></div></div><div class="new-strip">{latest.slice(0,4).map(item => <Card item={item} compact />)}</div></section>}
<section class="shell all-section"><div class="section-heading all-heading"><div><div class="section-kicker">BROWSE</div><h2>All resources</h2></div><p id="result-count" aria-live="polite">{activeItems.length} resources</p></div><div class="cards-grid" id="cards">{activeItems.map(item => <Card item={item}/>)}</div><div class="empty-state" id="empty" hidden><h3>No matching resources.</h3><p>Try a different search or clear your filters.</p><button id="clear-filters">Clear filters</button></div></section></main><Fragment slot="footer"><p>{updated ? `Last updated ${date(updated)} · ` : ''}{activeItems.length} resources</p></Fragment><script src="../scripts/search.ts"></script></Base>
