---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { activeItems, date, label, slug } from '../lib/items';
import tags from '../../data/tags.json';
const latest = activeItems.slice(0, 4);
const updated = activeItems.map(i => i.updated_at).sort().at(-1);
const usedTags = tags.filter(tag => activeItems.some(item => item.tags.includes(tag)));
---
<Base photoHeader><script is:inline>if(/[?&](q|type|tag)=/.test(location.search))location.replace("/browse/"+location.search)</script><main id="main"><section class="hero hero-photo"><picture class="hero-media"><source media="(max-width: 600px)" type="image/avif" srcset="/hero/theatre-phone.avif"/><source media="(max-width: 600px)" type="image/webp" srcset="/hero/theatre-phone.webp"/><source type="image/avif" srcset="/hero/theatre-1200.avif 1200w, /hero/theatre-2000.avif 2000w, /hero/theatre-2800.avif 2800w" sizes="100vw"/><source type="image/webp" srcset="/hero/theatre-1200.webp 1200w, /hero/theatre-2000.webp 2000w, /hero/theatre-2800.webp 2800w" sizes="100vw"/><img src="/hero/theatre-2000.jpg" alt="" width="2000" height="1333" fetchpriority="high"/></picture><div class="hero-inner shell"><div class="hero-eyebrow">CARDIOLOGY &amp; CARDIAC ITU</div><h1 data-heartbeat>Tools and learning<br/><em>for cardiac care<span class="beat-dot">.</span></em></h1><p>A free directory of cardiology and cardiac critical care education resources, including tools, apps, courses and guidelines.</p><form class="search-box" role="search" action="/browse/" autocomplete="off"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><label class="sr-only" for="search">Search resources</label><input id="search" name="q" placeholder="Search tools, topics, creators"/><kbd>/</kbd><button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></form><div class="hero-footnote">FREE TO USE · NO SIGN-UP</div></div><p class="hero-credit">Photo by <a href="https://unsplash.com/photos/emergency-room-y6aFH6ZhI7s" target="_blank" rel="noopener">Piron Guillaume on Unsplash</a></p></section>
<section class="browse home-topics shell" aria-label="Browse by topic"><div class="tags-row"><span class="tags-heading">TOPICS</span><nav class="tag-scroll" aria-label="Browse by topic">{usedTags.map(tag => <a class="tag-chip" href={`/topics/${slug(tag)}/`}>{label(tag)}</a>)}</nav></div></section>
<section class="shell new-section home-latest"><div class="section-heading"><div><div class="section-kicker">LATEST</div><h2>Recently added</h2></div><a class="see-all" href="/browse/">All {activeItems.length} resources <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div><div class="new-strip">{latest.map(item => <Card item={item} compact />)}</div><a class="secondary-button browse-all" href="/browse/">Browse all {activeItems.length} resources</a></section></main><Fragment slot="footer"><p>{updated ? `Last updated ${date(updated)} · ` : ''}{activeItems.length} resources</p></Fragment><script src="../scripts/home.ts"></script><script src="../scripts/heartbeat.ts"></script></Base>
