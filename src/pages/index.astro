---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { activeItems, date, inType, label, pluralLabel, slug, usedTypes } from '../lib/items';
import { topicStyle } from '../lib/art';
import { starterSets } from '../lib/collections';
import { getPublishedPosts } from '../lib/blog';
import tags from '../../data/tags.json';
const latest = activeItems.slice(0, 4);
const updated = activeItems.map(i => i.updated_at).sort().at(-1);
const topicTiles = tags.map(tag => ({ tag, count: activeItems.filter(item => item.tags.includes(tag)).length, ...topicStyle(tag) })).filter(topic => topic.count);
const typeLinks = usedTypes.map(key => ({ key, count: activeItems.filter(item => inType(item, key)).length }));
const posts = (await getPublishedPosts()).slice(0, 2);
// Example searches under the search box: each must return results on Browse.
const tries = ['angiography', 'simulator', 'quiz', 'shock'];
const arrow = 'M5 12h14m-5-5 5 5-5 5';
---
<Base photoHeader><script is:inline>if(/[?&](q|type|tag)=/.test(location.search))location.replace("/browse/"+location.search)</script><main id="main"><section class="hero hero-photo"><picture class="hero-media"><source media="(max-width: 600px)" type="image/avif" srcset="/hero/theatre-phone.avif"/><source media="(max-width: 600px)" type="image/webp" srcset="/hero/theatre-phone.webp"/><source type="image/avif" srcset="/hero/theatre-1200.avif 1200w, /hero/theatre-2000.avif 2000w, /hero/theatre-2800.avif 2800w" sizes="100vw"/><source type="image/webp" srcset="/hero/theatre-1200.webp 1200w, /hero/theatre-2000.webp 2000w, /hero/theatre-2800.webp 2800w" sizes="100vw"/><img src="/hero/theatre-2000.jpg" alt="" width="2000" height="1333" fetchpriority="high"/></picture><div class="hero-inner shell"><div class="hero-eyebrow">CARDIOLOGY &amp; CARDIAC ITU</div><h1 data-heartbeat>Tools and learning<br/><em>for cardiac care<span class="beat-dot">.</span></em></h1><p>A free directory of cardiology and cardiac critical care education resources, including tools, apps, courses and guidelines.</p><form class="search-box" role="search" action="/browse/" autocomplete="off"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.8"/><path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><label class="sr-only" for="search">Search resources</label><input id="search" name="q" placeholder="Search tools, topics, creators"/><kbd>/</kbd><button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></form><nav class="hero-try" aria-label="Example searches"><span>Try</span>{tries.map(q => <a href={`/browse/?q=${encodeURIComponent(q)}`}>{q}</a>)}</nav><div class="hero-footnote">FREE TO USE · NO SIGN-UP</div></div><p class="hero-credit">Photo by <a href="https://unsplash.com/photos/emergency-room-y6aFH6ZhI7s" target="_blank" rel="noopener">Piron Guillaume on Unsplash</a></p></section>
<section class="shell home-section" aria-labelledby="topics-heading">
  <div class="section-heading"><div><div class="section-kicker">BROWSE</div><h2 id="topics-heading">Browse by topic</h2></div><a class="see-all" href="/topics/">All topics <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
  <ul class="topic-tiles">{topicTiles.map(topic => <li><a class="topic-tile" style={`--topic:${topic.colour}`} href={`/topics/${slug(topic.tag)}/`}><svg class="art-motif" viewBox="0 0 350 219" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path d={topic.motif}/></svg><span class="topic-name">{label(topic.tag)}</span><span class="topic-count">{topic.count}<span class="sr-only"> {topic.count === 1 ? 'resource' : 'resources'}</span></span></a></li>)}</ul>
  <a class="secondary-button browse-all" href="/topics/">All {topicTiles.length} topics</a>
  <nav class="type-links" aria-label="Browse by type"><span class="tags-heading">BY TYPE</span>{typeLinks.map(type => <a class="tag-chip" href={`/types/${type.key}/`}>{pluralLabel(type.key)}<span>{type.count}</span></a>)}</nav>
</section>
<section class="shell new-section home-latest"><div class="section-heading"><div><div class="section-kicker">LATEST</div><h2>Recently added</h2></div><a class="see-all" href="/browse/">All {activeItems.length} resources <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div><div class="new-strip">{latest.map(item => <Card item={item} compact />)}</div><a class="secondary-button browse-all" href="/browse/">Browse all {activeItems.length} resources</a></section>
{starterSets.length > 0 && <section class="shell home-section" aria-labelledby="start-heading">
  <div class="section-heading"><div><div class="section-kicker">START HERE</div><h2 id="start-heading">Where to begin</h2></div></div>
  <div class="starters">{starterSets.map(set => <article class="starter"><h3>{set.title}</h3><p>{set.blurb}</p><ol>{set.items.map(item => <li><a href={`/item/${item.id}/`}><span>{item.short_title ?? item.title}</span><span>{label(item.type)}</span></a></li>)}</ol></article>)}</div>
</section>}
{posts.length > 0 && <section class="shell home-section" aria-labelledby="blog-heading">
  <div class="section-heading"><div><div class="section-kicker">BLOG</div><h2 id="blog-heading">From the blog</h2></div><a class="see-all" href="/blog/">All articles <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
  <div class="home-posts">{posts.map(post => <article class="home-post"><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><time datetime={post.data.published.toISOString()}>{date(post.data.published.toISOString())}</time></article>)}</div>
</section>}
<section class="shell home-section home-close" aria-label="About and suggestions">
  <div class="close-panel"><div class="section-kicker">WHO RUNS IT</div><h2>Curated by a cardiology registrar</h2><p>I'm Ike, a cardiology registrar training in England. Every listing starts from a link I've chosen or a suggestion I've approved. Nobody pays to be listed.</p><a class="see-all" href="/about/">About MedPally Find <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
  <div class="close-panel close-suggest"><div class="section-kicker">SUGGEST</div><h2>Know a resource that should be here?</h2><p>Send me the link. I review every suggestion before it goes live.</p><a class="primary-button" href="/suggest/">Suggest a resource</a></div>
</section></main><Fragment slot="footer"><p>{updated ? `Last updated ${date(updated)} · ` : ''}{activeItems.length} resources</p></Fragment><script src="../scripts/home.ts"></script><script src="../scripts/heartbeat.ts"></script></Base>
