---
import Landing from '../../components/Landing.astro';
import { activeItems, slug } from '../../lib/items';
import topics from '../../../data/topics.json';
export function getStaticPaths() {
  return Object.entries(topics).flatMap(([tag, content]) => {
    const listings = activeItems.filter(item => item.tags.includes(tag));
    return listings.length ? [{ params: { slug: slug(tag) }, props: { tag, content, listings } }] : [];
  });
}
const { tag, content, listings } = Astro.props;
---
<Landing content={content} listings={listings} kind="topic" value={tag}/>
